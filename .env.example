# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY="your-llm-api-key" # e.g. OpenAI API key
DEFAULT_LLM_MODEL=gpt-5-mini

# Atlas Cloud (OpenAI-compatible) — alternative to OpenAI, access 59+ LLMs with one key
# Get your free key at: https://www.atlascloud.ai/console/coding-plan
# OPENAI_BASE_URL=https://api.atlascloud.ai/v1
# OPENAI_API_KEY=<your-atlascloud-key>
# DEFAULT_LLM_MODEL=deepseek-ai/deepseek-v4-pro
DEFAULT_LLM_TEMPERATURE=0.2
SESSION_NAMING_ENABLED=true

# Long-term memory embedding (Ollama on the Docker host)
# Use http://localhost:11434 when running the FastAPI app directly on the host.
LONG_TERM_MEMORY_MODEL=gpt-5-mini
LONG_TERM_MEMORY_EMBEDDER_PROVIDER=ollama
LONG_TERM_MEMORY_EMBEDDER_MODEL=nomic-embed-text:latest
LONG_TERM_MEMORY_EMBEDDER_BASE_URL=http://host.docker.internal:11434
LONG_TERM_MEMORY_EMBEDDER_DIMS=768
LONG_TERM_MEMORY_COLLECTION_NAME=longterm_memory_nomic_768
LONG_TERM_MEMORY_MAX_RESULTS=5
# pgvector cosine distance: lower means more relevant; 0.35 is roughly cosine similarity >= 0.65.
LONG_TERM_MEMORY_MAX_COSINE_DISTANCE=0.35
NO_PROXY=localhost,127.0.0.1,host.docker.internal

# OpenViking Knowledge Base Tools (optional)
# When this FastAPI app runs in Docker and OpenViking runs on the Windows host,
# use http://host.docker.internal:1933 instead of http://localhost:1933.
OPENVIKING_ENABLED=true
OPENVIKING_BASE_URL=http://host.docker.internal:1933
OPENVIKING_AUTH_MODE=api_key
OPENVIKING_API_KEY=Y2ZmZXg.UGVuZ1dlaQ.N2FmOGE1MGNjNWJhNzJjMmNjNjgzZjYzYWE1ODM1NjFkOGJlNGFkMTJmMmQ4NTYzMjA2NzcyYTA2ZWE0NjUwOQ
# Only required for OpenViking trusted auth mode:
OPENVIKING_ACCOUNT=cffex
OPENVIKING_USER=PengWei
OPENVIKING_TIMEOUT_SECONDS=30

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Profiling Settings
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console
